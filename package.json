{
  "name": "ponkotsu",
  "version": "0.1.0",
  "private": true,
  "description": "Generates a Material Design 3 style tonal color system (CSS custom properties) from a small set of seed colors.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "npm run build && node build/src/generate.js",
    "app:install": "npm install --prefix app",
    "app:dev": "npm run dev --prefix app",
    "app:build": "npm run build --prefix app"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.6.0"
  }
}
